<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_silver">

    <!-- 视频是根层：解码 Surface 始终覆盖整屏（JSLINK 同款，不切换 Activity） -->
    <!-- 黑色底板：回桌面再进/切后台回来时，解码器重建的空窗期透过 SurfaceView
         露出的是这块纯黑而非根布局银色渐变——观感是"正在恢复画面"而不是出错 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true" />

    <!-- CarPlay 圆角黑边（代码动态插入，见 MainActivity）：视频流是直角满幅，
         真车的圆角由这层画黑角实现；XML 声明在 R8 与 shrinkResources 组合下
         inflate 不稳，动态创建绕过整套 XML 反射链路。 -->

    <!-- ===================== 等待页（双栏布局用足 1920 宽度，全控件放大） ===================== -->
    <ScrollView
        android:id="@+id/waiting_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp">

            <!-- 顶部品牌横条：JSplay 图标 + 名称 + 右侧状态徽章 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="JSplay"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="JSplay"
                    android:textColor="#F2F5F8"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_purple"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="就绪"
                    android:textColor="#37414E"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 主体双栏：左=模式卡+WiFi 输入，右=自启+功能按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- ============ 左栏（60%）：三张模式卡 + WiFi 名字/密码 ============ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="60"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/mode_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="10dp"
                            android:text="选择连接方式（需先完成蓝牙配对）"
                            android:textColor="#A6ACB5"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- ① 车机热点（默认） -->
                            <LinearLayout
                                android:id="@+id/card_hotspot"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/card_selected"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <ImageView
                                    android:layout_width="76dp"
                                    android:layout_height="76dp"
                                    android:contentDescription="车机热点"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_mode_car" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="车机热点"
                                    android:textColor="#2A2E36"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="自动开热点\niPhone 自动加入"
                                    android:textColor="#3A4048"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="1dp" />

                            <!-- ② 同网模式 -->
                            <LinearLayout
                                android:id="@+id/card_samenet"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/panel_purple_dark"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <ImageView
                                    android:layout_width="76dp"
                                    android:layout_height="76dp"
                                    android:contentDescription="同网模式"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_mode_router" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="同一 WiFi"
                                    android:textColor="#D5D9DF"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="车机与 iPhone\n连同一个路由器"
                                    android:textColor="#8E959E"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="1dp" />

                            <!-- ③ iPhone 热点 -->
                            <LinearLayout
                                android:id="@+id/card_iphone_hotspot"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/panel_purple_dark"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <ImageView
                                    android:layout_width="76dp"
                                    android:layout_height="76dp"
                                    android:contentDescription="iPhone热点"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_mode_phone" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="iPhone 热点"
                                    android:textColor="#D5D9DF"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="系统先连接 iPhone 热点\n一键复用当前网络"
                                    android:textColor="#8E959E"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- WiFi 输入小框（收窄于左栏，不通栏）：名字+信道一行、密码一行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/ssid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:background="@drawable/input_purple"
                            android:hint="WiFi名字（热点模式已连时免填）"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:singleLine="true"
                            android:textColor="#E8EBEF"
                            android:textColorHint="#7E858E"
                            android:textSize="18sp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <EditText
                            android:id="@+id/channel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/input_purple"
                            android:hint="信道"
                            android:inputType="number"
                            android:maxLength="3"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:singleLine="true"
                            android:textColor="#E8EBEF"
                            android:textColorHint="#7E858E"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/passphrase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/input_purple"
                        android:hint="密码（系统已保存时免填）"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:singleLine="true"
                        android:textColor="#E8EBEF"
                        android:textColorHint="#7E858E"
                        android:textSize="18sp" />
                </LinearLayout>

                <Space
                    android:layout_width="18dp"
                    android:layout_height="1dp" />

                <!-- ============ 右栏（40%）：开机自启 + 功能按钮纵排 ============ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="40"
                    android:orientation="vertical">

                    <!-- CarPlay 风格开关：胶囊轨道 + 圆点滑块 -->
                    <Switch
                        android:id="@+id/autostart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:switchMinWidth="72dp"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"
                        android:text="开机自启（上电自动连接）"
                        android:textColor="#A6ACB5"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btn_pair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/button_purple_outline"
                        android:minHeight="76dp"
                        android:text="选择手机"
                        android:textColor="#E8EBEF"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btn_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/button_purple_outline"
                        android:minHeight="76dp"
                        android:text="设置 · 日志"
                        android:textColor="#E8EBEF"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/button_purple_outline"
                        android:minHeight="76dp"
                        android:text="停止"
                        android:textColor="#E8EBEF"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 主按钮：通栏大按钮 -->
            <Button
                android:id="@+id/btn_wireless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_purple"
                android:minHeight="92dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="一键连接（车机热点）"
                android:textColor="#2A2E36"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
